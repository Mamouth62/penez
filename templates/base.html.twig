<!-- Section Héro -->
<section id="accueil" class="hero bg-dark text-white text-center py-5">
    <div class="container">
        <h1 class="display-4">Bienvenue dans mon univers photographique</h1>
        <p class="lead">Immortalisez vos plus beaux moments avec un regard artistique</p>
        <a href="#galerie" class="btn btn-primary btn-lg">Voir ma galerie</a>
    </div>
