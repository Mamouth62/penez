<!-- Section Galerie -->
<section id="galerie" class="gallery py-5">
    <div class="container text-center">
        <h2>Galerie</h2>
        <p class="lead">Découvrez une sélection de mes photos favorites.</p>
        <div class="row">
            <div class="col-md-4 mb-4">
                <img src="img/noel_arras.PNG" class="img-fluid rounded" alt="Photo 1">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/nature2.PNG" class="img-fluid rounded" alt="Photo 2">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/spiderman3.PNG" class="img-fluid rounded" alt="Photo 3">
            </div>
        </div>
        <a href="{{ path('app_galerie') }}" class="btn btn-primary">Voir plus</a>
    </div>
</section>

<!-- Section Services -->
<section id="services" class="services bg-light py-5">
    <div class="container text-center">
        <h2>Mes Services</h2>
        <div class="row">
             <div class="col-md-4 mb-4">
                <img src="img/shooting1.jpg" class="img-fluid rounded" alt="Photo 4">
