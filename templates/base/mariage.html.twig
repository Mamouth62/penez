	<!-- Lien vers Bootstrap CSS -->
	<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
	<!-- Style pour l'image en grand -->
	<style>
		/* Style pour l'image en grand dans le modal */
		#myModal {
			display: none;
			position: fixed;
			z-index: 1;
			left: 0;
			top: 0;
			width: 100%;
			height: 100%;
			background-color: rgba(0, 0, 0, 0.8);
			overflow: auto;
			text-align: center;
		}

		#myModal img {
			max-width: 80%;
			max-height: 80%;
			margin-top: 5%;
		}

		/* Style pour le bouton de fermeture */
		.close {
			position: absolute;
			top: 15px;
			right: 25px;
			color: #fff;
			font-size: 30px;
			font-weight: bold;
			cursor: pointer;
		}

		.close:hover,
		.close:focus {
			color: #bbb;
			text-decoration: none;
			cursor: pointer;
		}

		/* Style de la galerie */
		.row {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		/* Alignement des images */
		.col-md-6 {
			padding: 10px;
		}

		/* Application de min-height et object-fit pour uniformiser les images */
		.gallery-image {
			width: 100%;
			height: auto;
			object-fit: cover;
			border-radius: 10px;
			box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

		/* Effet de zoom sur l'image au survol */
		.gallery-image:hover {
			transform: scale(1.05);  /* Agrandissement léger */
			box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.5);  /* Ombre plus marquée */
		}

		/* Animation au clic pour l'effet de zoom */
		.gallery-image:active {
			transform: scale(1.1);  /* Agrandissement plus marqué lors du clic */
		}
	</style>
</head>
