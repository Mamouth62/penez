<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galerie - MonSite Photo</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <!-- Lien vers Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<!-- En-tête -->
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="#">MonSite Photo</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
              <li class="nav-item">
							<a class="nav-link" href="{{ path('app_base') }}">Accueil</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_galerie') }}">Galerie</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_article') }}">Article</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_events') }}">Events</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="#contact">Contact</a>
						</li>
            </ul>
        </div>
    </nav>
</header>

<!-- Section Portraits -->
<section id="portrait" class="gallery-section py-5">
    <div class="container">
        <h2 class="text-center">Portraits</h2>
        <p class="lead text-center">Découvrez une collection de portraits professionnels.</p>
        <div class="row">
            <div class="col-md-4 mb-4">
                <img src="img/shooting1.jpg" class="img-fluid rounded" alt="Portrait 1">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/shooting9.jpg" class="img-fluid rounded" alt="Portrait 2">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/shooting11.jpg" class="img-fluid rounded" alt="Portrait 3">
            </div>
        </div>
        <div class="text-center">
            <a href="{{ path('app_shooting') }}" class="btn btn-primary">Voir plus de portraits</a>
        </div>
    </div>
</section>

<!-- Section Événements -->
<section id="evenements" class="gallery-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center">Événements</h2>
        <p class="lead text-center">Capturer les moments inoubliables</p>
        <div class="row">
            <div class="col-md-4 mb-4">
                <img src="img/mariage9.jpg" class="img-fluid rounded" alt="Événement 1">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/mariage5.jpg" class="img-fluid rounded" alt="Événement 2">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/mariage4.jpg" class="img-fluid rounded" alt="Événement 3">
            </div>
        </div>
        <div class="text-center">
            <a href="{{ path('app_mariage') }}" class="btn btn-primary">Voir plus d'événements</a>
        </div>
    </div>
</section>

<!-- Section Paysages -->
<section id="paysages" class="gallery-section py-5">
    <div class="container">
        <h2 class="text-center">Paysages</h2>
        <p class="lead text-center">Immortalisez la beauté de la nature à travers des paysages.</p>
        <div class="row">
            <div class="col-md-4 mb-4">
                <img src="img/paris.PNG" class="img-fluid rounded" alt="Paysage 1">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/beffroi.PNG" class="img-fluid rounded" alt="Paysage 2">
            </div>
            <div class="col-md-4 mb-4">
                <img src="img/moulin1.PNG" class="img-fluid rounded" alt="Paysage 3">
            </div>
        </div>
        <div class="text-center">
            <a href="{{ path('app_paysage') }}" class="btn btn-primary">Voir plus de paysages</a>
        </div>
    </div>
</section>

<!-- Section Produits -->
<section id="produits" class="gallery-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center">Photographie de Produits</h2>
        <p class="lead text-center">Des photos professionnelles de vos produits pour vos campagnes marketing.</p>
        <div class="row">
            <div class="col-md-4 mb-4">
                <img src="produit1.jpg" class="img-fluid rounded" alt="Produit 1">
            </div>
            <div class="col-md-4 mb-4">
                <img src="produit2.jpg" class="img-fluid rounded" alt="Produit 2">
            </div>
            <div class="col-md-4 mb-4">
                <img src="produit3.jpg" class="img-fluid rounded" alt="Produit 3">
            </div>
        </div>
        <div class="text-center">
            <a href="portfolio.html#produits" class="btn btn-primary">Voir plus de produits</a>
        </div>
    </div>
</section>

<!-- Pied de page -->
<footer class="bg-dark text-white text-center py-4">
    <p>&copy; 2025 MonSite Photo. Tous droits réservés.</p>
    <div>
        <a href="https://instagram.com" target="_blank" class="text-white mx-3">Instagram</a>
        <a href="https://facebook.com" target="_blank" class="text-white mx-3">Facebook</a>
    </div>
</footer>

<!-- Lien vers les scripts Bootstrap -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>
</html>
