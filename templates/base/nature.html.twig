	<!-- Script JavaScript pour ouvrir et fermer le modal -->
	<script>
		// Fonction pour ouvrir l'image en grand dans un modal
		function openModal(imgElement) {
			var modal = document.getElementById("myModal");
			var modalImg = document.getElementById("modalImage");
			modal.style.display = "block";
			modalImg.src = imgElement.src; // Change l'image dans le modal avec celle cliquée
		}

		// Fonction pour fermer le modal
		function closeModal() {
			var modal = document.getElementById("myModal");
			modal.style.display = "none";
		}

		// Fermer le modal si l'utilisateur clique en dehors de l'image
		window.onclick = function(event) {
			var modal = document.getElementById("myModal");
			if (event.target == modal) {
				closeModal();
			}
		}
	</script>

